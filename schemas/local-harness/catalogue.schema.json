{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "enum": [
        "role",
        "capability",
        "skill",
        "tool"
      ],
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "maturity": {
      "enum": [
        "declared",
        "implemented",
        "qualified",
        "suspended"
      ],
      "title": "Maturity",
      "type": "string"
    },
    "domains": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Domains",
      "type": "array"
    },
    "experimental": {
      "default": false,
      "title": "Experimental",
      "type": "boolean"
    },
    "name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "order": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Order"
    },
    "legacy": {
      "default": false,
      "title": "Legacy",
      "type": "boolean"
    },
    "limitations": {
      "default": "",
      "title": "Limitations",
      "type": "string"
    },
    "task": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task"
    },
    "input_schema": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Schema"
    },
    "output_schema": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Schema"
    },
    "skills": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Skills",
      "type": "array"
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Tools",
      "type": "array"
    },
    "checks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Checks",
      "type": "array"
    },
    "handler": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Handler"
    },
    "permissions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "resources": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Resources",
      "type": "array"
    },
    "effects": {
      "default": "none",
      "enum": [
        "none",
        "read-file"
      ],
      "title": "Effects",
      "type": "string"
    },
    "instruction": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instruction"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "owner",
    "purpose",
    "maturity",
    "domains"
  ],
  "title": "Descriptor",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
