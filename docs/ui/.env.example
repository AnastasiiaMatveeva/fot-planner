# Ключи для разбора нормативных документов моделью.
# Скопируйте этот файл в .env и подставьте свой ключ.
# Сервер ищет .env (или env) в корне проекта и в docs/ui; оба имени в .gitignore.

# Claude — разбор со схемой, модель не может вернуть поле вне списка:
# ANTHROPIC_API_KEY=

# DeepSeek — разбор в режиме JSON, схему проверяет сам сервис:
# DEEPSEEK_API_KEY=

# Необязательно: какой моделью разбирать и чем перекрыть выбор провайдера.
# FOT_LLM_MODEL=deepseek-chat
# FOT_LLM_PROVIDER=deepseek
