# Настройки разбора нормативных документов моделью.
# Скопируйте этот файл в .env и подставьте значения.
# Сервер ищет .env (или env) в корне проекта и в docs/ui; оба имени в .gitignore.

# --- вариант А: модель на сервере организации (vLLM) --------------------------
# Идет первым, если задан адрес: документ не покидает сеть организации.
# Это единственный приемлемый вариант для документов по ГОЗ.
FOT_LLM_BASE_URL=http://192.168.150.188:8000/v1
FOT_LLM_MODEL=qwen38

# Ключ, если vLLM поднят с --api-key:
# FOT_LLM_API_KEY=
# Самоподписанный сертификат при работе по https:
# FOT_LLM_INSECURE_TLS=1
# Сервер не умеет response_format=json_schema:
# FOT_LLM_NO_SCHEMA=1
# Вернуть режим рассуждения моделям Qwen3 (медленнее, ответ тот же):
# FOT_LLM_THINKING=1

# --- вариант Б: облачные провайдеры -------------------------------------------
# Документ уходит целиком на сторонний сервер. Для ГОЗ не использовать.

# Claude — разбор со схемой, модель не может вернуть поле вне списка:
# ANTHROPIC_API_KEY=

# DeepSeek — разбор в режиме JSON, схему проверяет сам сервис:
# DEEPSEEK_API_KEY=

# Перекрыть автоматический выбор: local | anthropic | deepseek
# FOT_LLM_PROVIDER=
