{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo-ui",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "docs/ui/serve.py"
      ],
      "port": 8760,
      "url": "http://127.0.0.1:8760"
    },
    {
      "name": "app",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--app-dir",
        "app",
        "--host",
        "0.0.0.0",
        "--port",
        "8770"
      ],
      "port": 8770,
      "url": "http://127.0.0.1:8770"
    }
  ]
}
