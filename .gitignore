# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Секреты и локальные env
.env
.env.*
!.env.example

# IDE / редакторы
.idea/
.vscode/
*.swp
*~

# Cursor (кэш, MCP, чаты, локальные настройки агента)
.cursor/
!.cursor/rules/
!.cursor/rules/**

# OS
.DS_Store
Thumbs.db
desktop.ini

# Логи и временные файлы
*.log
_tstab/
_xfer_*.xlsx
tests/_tmp_*.xlsx

# Локальные архивы и справочные материалы (не в репозиторий)
*.zip
*.pdf

# Локальные настройки IDE
*.code-workspace

# Рабочие Excel (пересоздаются скриптами); в репозитории не храним
data/*.xlsx
!data/.gitkeep

# ключи моделей: оба написания, в репозиторий не попадают
/env
/docs/ui/env

# рабочие данные веб-приложения: база и загруженные документы
/app/data/

# Стенд: сгенерированные входы кризис-тестов
harness/_crisis/

# Локальные настройки Claude Code
.claude/settings.local.json

# Результаты прогонов: пересоздаются приёмкой и сквозным счётом
outputs/
